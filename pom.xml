<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- What every Porelo Maven repository shares: the JDK, the build tools' version, the plugin versions, and the
         ci-tools profile that puts porelo-release and porelo-machines on a classpath. -->
    <parent>
        <groupId>org.fuin.porelo</groupId>
        <artifactId>porelo-parent</artifactId>
        <version>0.2.1-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <!-- Never published. The package version is pubspec.yaml's, read by tool/package.sh. -->
    <groupId>org.fuin.porelo</groupId>
    <artifactId>porelo-frontend</artifactId>
    <version>0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>porelo-frontend</name>
    <description>The Porelo interface. Maven drives Flutter so an end-to-end run can lease a machine.</description>

    <!-- The same licence as the rest of Porelo; the text is in LICENSE. -->
    <licenses>
        <license>
            <name>GPL-3.0-only</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.txt</url>
        </license>
    </licenses>

    <properties>
        <!-- Which device flutter builds for at "package". Override with -Dflutter.target. -->
        <flutter.target>linux</flutter.target>
        <!-- Declared so -DskipTests resolves here as it does for surefire. -->
        <skipTests>false</skipTests>
    </properties>

    <build>
        <plugins>
            <!-- The shared code style for what is not Dart: the shell scripts, as shfmt writes them, checked
                 in validate. The parent pins it and its formatters, and leaves out hidden directories and
                 build output. -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
            <!-- Flutter and dart from PATH, with no profile around them: nothing here builds without
                 Flutter, and a profile that switched itself off would make a green build that did nothing. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>flutter-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>flutter</executable>
                            <arguments>
                                <argument>clean</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>flutter-pub-get</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>flutter</executable>
                            <arguments>
                                <argument>pub</argument>
                                <argument>get</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- The host package is pure Dart and has its own dependencies, so `dart analyze` here
                         can read it too. -->
                    <execution>
                        <id>host-pub-get</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>dart</executable>
                            <arguments>
                                <argument>pub</argument>
                                <argument>get</argument>
                                <argument>--directory=packages/porelo_host</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- dart, never flutter analyze, which rewrites analysis_options.yaml. Before the
                         build rather than after it: failing early is worth leaving the template's order. -->
                    <!-- As `dart format` writes it, at the width analysis_options.yaml takes from the shared
                         .editorconfig; the generated tests too, which the build formats after generating. -->
                    <execution>
                        <id>dart-format</id>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>dart</executable>
                            <arguments>
                                <argument>format</argument>
                                <argument>--output=none</argument>
                                <argument>--set-exit-if-changed</argument>
                                <argument>lib</argument>
                                <argument>test</argument>
                                <argument>tool</argument>
                                <argument>integration_test</argument>
                                <argument>packages/porelo_host</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>dart-analyze</id>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>dart</executable>
                            <arguments>
                                <argument>analyze</argument>
                                <argument>--fatal-infos</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>host-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${skipTests}</skip>
                            <executable>dart</executable>
                            <workingDirectory>packages/porelo_host</workingDirectory>
                            <arguments>
                                <argument>test</argument>
                                <argument>--exclude-tags=keystore</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- The secret store against a Secret Service of its own, never the person's keyring. -->
                    <execution>
                        <id>host-keystore-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${skipTests}</skip>
                            <executable>bash</executable>
                            <arguments>
                                <argument>packages/porelo_host/tool/keyring-test.sh</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- The file reporter feeds the build's summary; the console keeps its own output. -->
                    <execution>
                        <id>flutter-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${skipTests}</skip>
                            <executable>flutter</executable>
                            <arguments>
                                <argument>test</argument>
                                <argument>--file-reporter=json:build/test-results.json</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>flutter-build</id>
                        <phase>package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>flutter</executable>
                            <arguments>
                                <argument>build</argument>
                                <argument>${flutter.target}</argument>
                                <argument>--release</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Against the machine PORELO_E2E_* names. Failsafe's shape: the run never fails its phase, so
             whatever follows it still runs, and verify fails the build from the status it left. -->
        <profile>
            <id>e2e</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>e2e-run</id>
                                <phase>integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>-c</argument>
                                        <argument>mkdir -p build; tool/e2e.sh --file-reporter=json:build/e2e-results.json; echo $? &gt; build/e2e.status</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>e2e-verdict</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>-c</argument>
                                        <argument>exit "$(cat build/e2e.status)"</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- A machine leased for the run and swept after it, whether the tests passed or not. With
             e2e: ./mvnw verify -Pe2e,hetzner, HETZNER_API set, and the key as HETZNER_SSH (CI) or a
             file named by HETZNER_KEY (a person). Only here, so no other build fetches the tool.
             PORELO_CANDIDATE names a directory of locally built porelo packages to install over the
             published ones, so the leg can test a porelo nobody has pushed yet. Not the parent's ci-tools,
             which only puts the tools on a classpath: this one also rents and sweeps. Its tool's version is
             the parent's. -->
        <profile>
            <id>hetzner</id>
            <dependencies>
                <dependency>
                    <groupId>org.fuin.porelo</groupId>
                    <artifactId>porelo-machines</artifactId>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <!-- Its own JVM, so the tool's exit cannot take Maven down with it. The
                                 classpath arrives as $0; with HETZNER_SSH set the tool needs no key file. -->
                            <execution>
                                <id>hetzner-lease</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>-c</argument>
                                        <argument>test -z "$HETZNER_KEY" || set -- --key "$HETZNER_KEY"; test -z "$PORELO_CANDIDATE" || set -- "$@" --candidate "$PORELO_CANDIDATE"; exec java -classpath "$0" org.fuin.porelo.machines.Main lease --os ubuntu "$@" --write build/leased.properties</argument>
                                        <classpath/>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>hetzner-sweep</id>
                                <phase>post-integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>java</executable>
                                    <arguments>
                                        <argument>-classpath</argument>
                                        <classpath/>
                                        <argument>org.fuin.porelo.machines.Main</argument>
                                        <argument>sweep</argument>
                                        <argument>--from</argument>
                                        <argument>build/leased.properties</argument>
                                        <argument>--now</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <!-- Only once the sweep has worked: a failed sweep leaves the file for a
                                 person, and a swept one must not be read as a machine still there. -->
                            <execution>
                                <id>hetzner-done</id>
                                <phase>post-integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>-c</argument>
                                        <argument>mv -f build/leased.properties build/leased.swept</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
